#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
    mkdir -p /var/lib/picast /run/picast
    chmod 0755 /usr/bin/picast || true
    if command -v systemctl >/dev/null 2>&1; then
        systemctl daemon-reload || true
        # Network lockout watchdog: auto-restores NetworkManager if picast ever
        # leaves the radio unassociated for >90s (bad deploy safety net).
        systemctl enable picast-watchdog.timer >/dev/null 2>&1 || true
        systemctl start picast-watchdog.timer >/dev/null 2>&1 || true
        echo "picast installed. Run 'sudo picast configure' then 'sudo picast service enable' to start on boot."
    fi
fi

exit 0
