#!/usr/bin/env python3
"""Installed wrapper launching the `picast` control-plane CLI from /usr/lib/picast/python."""

from __future__ import annotations

from pathlib import Path
import sys

PYTHON_LIB = Path("/usr/lib/picast/python")
if PYTHON_LIB.exists() and str(PYTHON_LIB) not in sys.path:
    sys.path.insert(0, str(PYTHON_LIB))

from picast.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
